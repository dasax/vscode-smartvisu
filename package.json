{
	"name": "smartvisu-assistant",
	"displayName": "smartVISU Assistant",
	"description": "%description%",
	"version": "0.3.7",
	"publisher": "dasax",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/dasax/vscode-smartvisu.git"
	},
	"homepage": "https://github.com/dasax/vscode-smartvisu#readme",
	"bugs": {
		"url": "https://github.com/dasax/vscode-smartvisu/issues"
	},
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Other"
	],
	"keywords": [
		"smartVISU",
		"SmartHomeNG",
		"smarthome.py",
		"Twig",
		"KNX",
		"home automation",
		"widgets"
	],
	"galleryBanner": {
		"color": "#2B2B2B",
		"theme": "dark"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:html",
		"onLanguage:twig",
		"onLanguage:jinja-html",
		"onLanguage:django-html",
		"onLanguage:nunjucks",
		"onLanguage:jinja",
		"onLanguage:twig-html"
	],
	"contributes": {
		"commands": [
			{
				"command": "smartvisu.insertWidget",
				"title": "%command.insertWidget%",
				"category": "smartVISU",
				"icon": "$(symbol-method)"
			},
			{
				"command": "smartvisu.insertItem",
				"title": "%command.insertItem%",
				"category": "smartVISU",
				"icon": "$(symbol-field)"
			},
			{
				"command": "smartvisu.openDocs",
				"title": "%command.openDocs%",
				"category": "smartVISU",
				"icon": "$(book)"
			},
			{
				"command": "smartvisu.selectVersion",
				"title": "%command.selectVersion%",
				"category": "smartVISU",
				"icon": "$(versions)"
			},
			{
				"command": "smartvisu.reload",
				"title": "%command.reload%",
				"category": "smartVISU",
				"icon": "$(refresh)"
			},
			{
				"command": "smartvisu.afterInsert",
				"title": "smartVISU: after insert"
			},
			{
				"command": "smartvisu.suggestDetails",
				"title": "smartVISU: suggestion details"
			},
			{
				"command": "smartvisu.guide.search",
				"title": "%command.guide.search%",
				"category": "smartVISU",
				"icon": "$(search)"
			},
			{
				"command": "smartvisu.guide.insert",
				"title": "%command.guide.insert%",
				"category": "smartVISU",
				"icon": "$(add)"
			},
			{
				"command": "smartvisu.guide.openDocs",
				"title": "%command.guide.openDocs%",
				"category": "smartVISU",
				"icon": "$(book)"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "smartvisu.insertWidget",
					"when": "editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/",
					"group": "smartvisu@1"
				},
				{
					"command": "smartvisu.insertItem",
					"when": "editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/",
					"group": "smartvisu@2"
				},
				{
					"command": "smartvisu.openDocs",
					"when": "editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/",
					"group": "smartvisu@3"
				}
			],
			"commandPalette": [
				{
					"command": "smartvisu.afterInsert",
					"when": "false"
				},
				{
					"command": "smartvisu.suggestDetails",
					"when": "false"
				},
				{
					"command": "smartvisu.guide.insert",
					"when": "false"
				},
				{
					"command": "smartvisu.guide.openDocs",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "smartvisu.guide.search",
					"when": "view == smartvisu.guide",
					"group": "navigation@1"
				},
				{
					"command": "smartvisu.reload",
					"when": "view == smartvisu.guide",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "smartvisu.guide.openDocs",
					"when": "view == smartvisu.guide && viewItem =~ /^(widget|customWidget)$/",
					"group": "inline@1"
				},
				{
					"command": "smartvisu.guide.insert",
					"when": "view == smartvisu.guide && viewItem =~ /^(widget|customWidget|snippet)$/",
					"group": "inline@2"
				},
				{
					"command": "smartvisu.guide.insert",
					"when": "view == smartvisu.guide && viewItem =~ /^(widget|customWidget|snippet)$/",
					"group": "navigation@1"
				},
				{
					"command": "smartvisu.guide.openDocs",
					"when": "view == smartvisu.guide && viewItem =~ /^(widget|customWidget)$/",
					"group": "navigation@2"
				}
			]
		},
		"keybindings": [
			{
				"command": "smartvisu.insertWidget",
				"key": "ctrl+shift+alt+w",
				"mac": "cmd+shift+alt+w",
				"when": "editorTextFocus && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "smartvisu.insertItem",
				"key": "ctrl+shift+alt+t",
				"mac": "cmd+shift+alt+t",
				"when": "editorTextFocus && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "smartvisu.guide.focus",
				"key": "ctrl+shift+alt+g",
				"mac": "cmd+shift+alt+g",
				"when": "smartvisu.guide.available"
			},
			{
				"command": "smartvisu.guide.insert",
				"key": "enter",
				"when": "focusedView == smartvisu.guide && listFocus && !inputFocus && !treeElementHasChild"
			},
			{
				"command": "smartvisu.suggestDetails",
				"key": "right",
				"args": {
					"open": true,
					"hide": true
				},
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetHasFocusedSuggestion && !suggestWidgetDetailsVisible && !suggestWidgetDetailsFocused && editorTextFocus && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "smartvisu.suggestDetails",
				"key": "right",
				"args": {
					"open": true,
					"hide": false
				},
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetHasFocusedSuggestion && suggestWidgetDetailsVisible && !suggestWidgetDetailsFocused && editorTextFocus && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "selectNextPageSuggestion",
				"key": "down",
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetDetailsFocused && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "selectPrevPageSuggestion",
				"key": "up",
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetDetailsFocused && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "smartvisu.suggestDetails",
				"key": "left",
				"args": {
					"close": true
				},
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetDetailsFocused && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			},
			{
				"command": "smartvisu.suggestDetails",
				"key": "escape",
				"args": {
					"close": true,
					"hideWidget": true
				},
				"when": "config.smartvisu.suggestDetailsKeys && suggestWidgetVisible && suggestWidgetDetailsFocused && editorLangId =~ /^(html|twig|jinja-html|django-html|nunjucks|jinja|twig-html)$/"
			}
		],
		"configuration": {
			"title": "smartVISU Assistant",
			"properties": {
				"smartvisu.version": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"installed",
						"3.6",
						"3.5",
						"3.4",
						"3.3",
						"3.2",
						"3.1",
						"3.0",
						"2.9"
					],
					"markdownEnumDescriptions": [
						"%config.version.auto%",
						"%config.version.installed%"
					],
					"markdownDescription": "%config.version%",
					"order": 0
				},
				"smartvisu.installPath": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.installPath%",
					"order": 1
				},
				"smartvisu.items.source": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"shngItems",
						"path",
						"masteritem",
						"none"
					],
					"markdownEnumDescriptions": [
						"%config.items.source.auto%",
						"%config.items.source.shngItems%",
						"%config.items.source.path%",
						"%config.items.source.masteritem%",
						"%config.items.source.none%"
					],
					"markdownDescription": "%config.items.source%",
					"order": 2
				},
				"smartvisu.items.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.items.path%",
					"order": 3
				},
				"smartvisu.items.typeFilter": {
					"type": "string",
					"default": "learned",
					"enum": [
						"learned",
						"widget",
						"off"
					],
					"markdownEnumDescriptions": [
						"%config.items.typeFilter.learned%",
						"%config.items.typeFilter.widget%",
						"%config.items.typeFilter.off%"
					],
					"markdownDescription": "%config.items.typeFilter%",
					"order": 4
				},
				"smartvisu.insertParameters": {
					"type": "string",
					"default": "learned",
					"enum": [
						"learned",
						"required",
						"all"
					],
					"markdownEnumDescriptions": [
						"%config.insertParameters.learned%",
						"%config.insertParameters.required%",
						"%config.insertParameters.all%"
					],
					"markdownDescription": "%config.insertParameters%",
					"order": 5
				},
				"smartvisu.autoSuggest": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.autoSuggest%",
					"order": 6
				},
				"smartvisu.suggestDetailsKeys": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.suggestDetailsKeys%",
					"order": 7
				},
				"smartvisu.diagnostics": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.diagnostics%",
					"order": 8
				},
				"smartvisu.docuUrl": {
					"type": "string",
					"default": "https://docu.smartvisu.de/{docuVersion}/index.php?page={package}/widget_{widget}",
					"markdownDescription": "%config.docuUrl%",
					"order": 9
				},
				"smartvisu.language": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"en",
						"de"
					],
					"enumItemLabels": [
						"Auto",
						"English",
						"Deutsch"
					],
					"markdownDescription": "%config.language%",
					"order": 10
				}
			}
		},
		"views": {
			"explorer": [
				{
					"id": "smartvisu.guide",
					"name": "%view.guide%",
					"icon": "media/guide.svg",
					"contextualTitle": "smartVISU",
					"when": "smartvisu.guide.available"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "smartvisu.guide",
				"contents": "%viewsWelcome.guide%"
			}
		]
	}
}
